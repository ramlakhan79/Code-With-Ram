{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://code-with-ram-server.onrender.com/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://code-with-ram-server.onrender.com/api/seo/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://code-with-ram-server.onrender.com/api/seo/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
